From: Jan Janssen <jan-janssen@users.noreply.github.com>
Date: Sat, 8 Jun 2024 06:26:27 +0200
Subject: [PATCH] Remove auditwheel

---
 pyproject.toml | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -1,5 +1,5 @@
 [build-system]
-requires = ["setuptools==82.0.1", "setuptools-scm==10.3.4", "wheel==0.48.0", "auditwheel==6.7.0"]
+requires = ["setuptools==82.0.1", "setuptools-scm==10.3.4", "wheel==0.48.0"]
 build-backend = "setuptools.build_meta"
 
 [project]
@@ -9,7 +9,7 @@
     {name = "Microsoft Corporation"}
 ]
 readme = "README.md"
-license = "Apache-2.0"
+license = { text = "Apache-2.0" }
 dynamic = ["version"]
 requires-python = ">=3.10"
 # Please when changing dependencies run the following commands to update requirements.txt:
